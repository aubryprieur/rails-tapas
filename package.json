{
  "name": "tapas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --format=esm --minify --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.sass.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "@rails/actiontext": "^8.1.0",
    "@rails/activestorage": "^8.1.0",
    "@rails/ujs": "^7.1.3",
    "animate.css": "^4.1.1",
    "bootstrap": "^5.3.3",
    "esbuild": "^0.25.0",
    "jquery": "^3.7.1",
    "sass": "^1.107.0",
    "trix": "^2.1.15"
  },
  "engines": {
    "node": "22.x",
    "yarn": "1.x"
  }
}
