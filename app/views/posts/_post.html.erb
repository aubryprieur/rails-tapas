<% deadline = deadline_info(post) %>
<article class="ao-tile ao-tile--<%= deadline[:status] %>"
         data-search="<%= [post.client, post.title].join(' ').downcase %>"
         data-new="<%= new_post?(post) %>">
  <div class="ao-tile__top">
    <span class="ao-tile__client" title="<%= post.client %>"><%= post.client %></span>

    <div class="ao-tile__actions">
      <% if new_post?(post) %>
        <span class="ao-tile__new">Nouveau</span>
      <% end %>
      <% if favorited?(post) %>
        <%= link_to favorite_post_path(post), method: :delete, class: "ao-icon-btn is-active", title: "Retirer des favoris", "aria-label": "Retirer des favoris" do %>
          <i class="fa-solid fa-bookmark"></i>
        <% end %>
      <% else %>
        <%= link_to favorite_posts_path(post_id: post), method: :post, class: "ao-icon-btn", title: "Ajouter aux favoris", "aria-label": "Ajouter aux favoris" do %>
          <i class="fa-regular fa-bookmark"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <h3 class="ao-tile__title">
    <%= link_to post.title.to_s.upcase_first, post_path(post), class: "ao-tile__link" %>
  </h3>

  <% excerpt = post.rich_body.present? ? post.rich_body.to_plain_text : post.try(:description).to_s %>
  <% if excerpt.present? %>
    <p class="ao-tile__excerpt"><%= excerpt.squish.truncate(160) %></p>
  <% else %>
    <p class="ao-tile__excerpt ao-tile__excerpt--empty">Aucune description</p>
  <% end %>

  <div class="ao-tile__footer">
    <span class="ao-tile__deadline ao-deadline--<%= deadline[:status] %>" title="Date limite de réponse">
      <i class="fa-regular fa-calendar"></i>
      <%= post.deadline.strftime("%d/%m/%Y") %>
      <span class="ao-deadline__badge"><%= deadline[:label] %></span>
    </span>

    <span class="ao-tile__stats">
      <span title="Je lis l'AO"><i class="fa-solid fa-book-open-reader"></i> <%= post.readings.size %></span>
      <span title="Je réponds"><i class="fa-solid fa-pen-nib"></i> <%= post.likes.size %></span>
      <span title="J'intègre l'équipe"><i class="fa-solid fa-user-plus"></i> <%= post.teams.size %></span>
      <% if post.photo.attached? %>
        <%= link_to post_attachment_download_url(post), class: "ao-icon-btn ao-icon-btn--small", title: "Télécharger le dossier", "aria-label": "Télécharger le dossier" do %>
          <i class="fa-solid fa-paperclip"></i>
        <% end %>
      <% end %>
    </span>
  </div>
</article>
