<%
  positions = [
    { label: "Je lis l'AO",         icon: "fa-book-open-reader", color: "#167FFB",
      records: @post.readings,   create: post_readings_path(@post),   destroy: ->(r) { post_reading_path(@post, r) } },
    { label: "J'appelle le client", icon: "fa-phone",            color: "#E67E22",
      records: @post.calls,      create: post_calls_path(@post),      destroy: ->(r) { post_call_path(@post, r) } },
    { label: "Je réponds",          icon: "fa-pen-nib",          color: "#E0A82E",
      records: @post.likes,      create: post_likes_path(@post),      destroy: ->(r) { post_like_path(@post, r) } },
    { label: "J'intègre l'équipe",  icon: "fa-user-plus",        color: "#18B572",
      records: @post.teams,      create: post_teams_path(@post),      destroy: ->(r) { post_team_path(@post, r) } },
    { label: "Pas pour moi",        icon: "fa-circle-xmark",     color: "#8A8F98",
      records: @post.rejections, create: post_rejections_path(@post), destroy: ->(r) { post_rejection_path(@post, r) } }
  ]
%>

<div class="positions">
  <% positions.each do |position| %>
    <%= render "position_card", position: position %>
  <% end %>
</div>
