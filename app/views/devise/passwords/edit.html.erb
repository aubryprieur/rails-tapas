<% content_for :title, "Nouveau mot de passe" %>
<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Nouveau mot de passe</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="auth-field">
        <%= f.label :password, "Nouveau mot de passe" %>
        <% if @minimum_password_length %>
          <small class="auth-hint"><%= @minimum_password_length %> caractères minimum</small>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "Confirmez le mot de passe" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <%= f.submit "Changer mon mot de passe", class: "ao-btn ao-btn--primary auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
