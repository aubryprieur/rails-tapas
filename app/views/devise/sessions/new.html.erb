<% content_for :title, "Connexion" %>
<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Connexion</h1>
    <p class="auth-card__subtitle">Accédez aux appels d'offres de l'équipe.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="auth-field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "prenom.nom@copas.coop" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Mot de passe" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="auth-check">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Se souvenir de moi", class: "form-check-label" %>
        </div>
      <% end %>

      <%= f.submit "Se connecter", class: "ao-btn ao-btn--primary auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
