<p>Bonjour,</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>Nous vous informons que l'email de votre compte TAPAS est en cours de modification vers <%= @resource.unconfirmed_email %>.</p>
<% else %>
  <p>Nous vous informons que l'email de votre compte TAPAS a été modifié : <%= @resource.email %>.</p>
<% end %>
