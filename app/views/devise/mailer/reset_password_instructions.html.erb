<% content_for :preheader, "Choisissez un nouveau mot de passe pour TAPAS" %>

<h1 style="margin:0 0 10px; font-size:24px; line-height:1.3; color:#22252A;">Mot de passe oublié ?</h1>
<p style="margin:0;">Bonjour <%= @resource.try(:first_name).presence || @resource.email %>,</p>
<p style="margin:8px 0 0;">Vous avez demandé à changer votre mot de passe TAPAS. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.</p>

<%= render "shared/mailer/button", url: edit_password_url(@resource, reset_password_token: @token), label: "Choisir un nouveau mot de passe" %>

<p style="margin:16px 0 0; font-size:14px; color:#7A7F87;">
  Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email :
  votre mot de passe ne changera pas.
</p>
