<div class="ao-page">
  <div class="container">
    <header class="ao-list-header">
      <div>
        <h1 class="ao-list-header__title">Mes favoris</h1>
        <p class="ao-list-header__subtitle">
          <% if @posts.any? %>
            <%= pluralize(@posts.size, "appel d'offres suivi", plural: "appels d'offres suivis") %>, classés par date limite
          <% else %>
            Retrouvez ici les appels d'offres que vous suivez.
          <% end %>
        </p>
      </div>
    </header>

    <% if @posts.empty? %>
      <%= render "shared/empty_state",
                 icon: "fa-bookmark",
                 title: "Pas encore de favoris",
                 text: "Cliquez sur l'icône favori d'un appel d'offres pour le retrouver ici.",
                 link: ["Voir les appels d'offres", posts_path] %>
    <% else %>
      <div class="ao-tiles">
        <%= render partial: "posts/post", collection: @posts %>
      </div>
    <% end %>
  </div>
</div>
