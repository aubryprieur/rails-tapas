<% content_for :preheader, "#{@post.client} · #{@post.title.to_s.truncate(80)} · réponse avant le #{@post.deadline.strftime('%d/%m/%Y')}" %>

<p style="margin:0 0 4px; font-size:13px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:#9A6B00;">Nouvel appel d'offres</p>
<h1 style="margin:0; font-size:24px; line-height:1.3; color:#22252A;">Un nouvel AO vient d'être publié</h1>

<%= render "shared/mailer/ao_card", post: @post, with_excerpt: true %>

<%= render "shared/mailer/button", url: post_url(@post), label: "Voir l'appel d'offres" %>

<p style="margin:16px 0 0; font-size:14px; color:#5F646C;">
  Ça vous intéresse ? Positionnez-vous (lecture, appel du client, réponse, équipe) ou laissez un commentaire directement sur la fiche.
</p>
