<% author = @comment.user&.first_name.presence || "Un membre" %>
<% content_for :preheader, "#{author} : #{@comment.body.to_s.squish.truncate(90)}" %>

<p style="margin:0 0 4px; font-size:13px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:#9A6B00;">Nouveau commentaire</p>
<h1 style="margin:0 0 18px; font-size:24px; line-height:1.3; color:#22252A;"><%= author %> a commenté un appel d'offres</h1>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:14px 18px; border-left:4px solid #F9CA62; border-radius:4px; background:#FFFBF0; font-size:15px; line-height:1.6; color:#22252A;">
      <%= simple_format(@comment.body, {}, wrapper_tag: "span") %>
    </td>
  </tr>
</table>

<%= render "shared/mailer/ao_card", post: @post %>

<%= render "shared/mailer/button", url: post_url(@post, anchor: "commentaires"), label: "Répondre sur TAPAS" %>
