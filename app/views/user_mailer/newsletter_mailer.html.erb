<% content_for :preheader, @weekly_activities.empty? ? "Pas d'activité cette semaine sur TAPAS" : "#{@weekly_activities.size} appel(s) d'offres actif(s) cette semaine sur TAPAS" %>

<p style="margin:0 0 4px; font-size:13px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:#9A6B00;">Récap de la semaine</p>
<h1 style="margin:0 0 6px; font-size:24px; line-height:1.3; color:#22252A;">L'activité sur TAPAS ces 7 derniers jours</h1>
<p style="margin:0 0 20px; color:#5F646C;">Les appels d'offres qui ont reçu des commentaires ou des positionnements cette semaine.</p>

<% if @weekly_activities.empty? %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding:28px; border:1.5px dashed #E4E6EA; border-radius:12px; text-align:center; color:#7A7F87;">
        Pas d'activité cette semaine. 😴
      </td>
    </tr>
  </table>
<% else %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <% @weekly_activities.each do |post| %>
      <%
        comments = post.comments.size
        positions = post.likes.size + post.readings.size + post.teams.size + post.calls.size
      %>
      <tr>
        <td style="padding:14px 0; border-bottom:1px solid #F0F0F0;">
          <span style="display:inline-block; padding:2px 8px; border-radius:999px; background:#FDF1D3; color:#9A6B00; font-size:10px; font-weight:700; letter-spacing:.5px; text-transform:uppercase;"><%= post.client %></span>
          <p style="margin:6px 0 4px; font-size:16px; font-weight:700; line-height:1.35;">
            <a href="<%= post_url(post) %>" target="_blank" style="color:#22252A; text-decoration:none;"><%= post.title.to_s.upcase_first %></a>
          </p>
          <p style="margin:0; font-size:13px; color:#7A7F87;">
            Avant le <%= post.deadline.strftime("%d/%m/%Y") %>
            <% if comments.positive? %> &nbsp;·&nbsp; 💬 <%= pluralize(comments, "commentaire", plural: "commentaires") %><% end %>
            <% if positions.positive? %> &nbsp;·&nbsp; ✋ <%= pluralize(positions, "positionnement", plural: "positionnements") %><% end %>
          </p>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>

<%= render "shared/mailer/button", url: posts_url, label: "Voir tous les appels d'offres" %>
