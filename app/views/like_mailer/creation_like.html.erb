<% who = @user&.first_name.presence %>
<% content_for :preheader, "#{who || 'Quelqu’un'} prépare une réponse · #{@post.client}" %>

<p style="margin:0 0 4px; font-size:13px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:#9A6B00;">Une réponse se prépare</p>
<h1 style="margin:0; font-size:24px; line-height:1.3; color:#22252A;">
  <%= who ? "#{who} prépare une réponse" : "Une réponse est en préparation" %>
</h1>
<p style="margin:10px 0 0; color:#5F646C;">Envie de rejoindre l'équipe ou d'aider à la rédaction de la proposition ?</p>

<%= render "shared/mailer/ao_card", post: @post %>

<%= render "shared/mailer/button", url: post_url(@post), label: "Rejoindre l'équipe" %>

<%# Julie s'occupe toujours du dossier administratif %>
<p style="margin:16px 0 0; font-size:14px; color:#5F646C;">Et bon courage à Julie pour la préparation du dossier administratif 👍</p>
